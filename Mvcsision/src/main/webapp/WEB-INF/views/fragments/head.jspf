<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Figtree:wght@400;600&display=swap" rel="stylesheet">
<style>
    :root {
        --ink: #15123B;
        --cobalt: #3D4DFF;
        --bone: #F7F5FF;
        --hot: #FF4F6D;
        --sun: #FFD23F;
        --mint: #33E0A1;
        --edge: 3px solid var(--ink);
        --display: 'Bricolage Grotesque', system-ui, sans-serif;
        --body: 'Figtree', system-ui, sans-serif;
    }

    *, *::before, *::after { box-sizing: border-box; }

    body {
        margin: 0;
        min-height: 100vh;
        color: var(--ink);
        font: 400 1.05rem/1.55 var(--body);
        background-color: var(--cobalt);
        background-image: radial-gradient(rgba(247, 245, 255, .22) 1.6px, transparent 1.7px);
        background-size: 24px 24px;
    }

    a { color: inherit; }
    :focus-visible { outline: 3px solid var(--sun); outline-offset: 3px; }
    .card :focus-visible, .panel :focus-visible { outline-color: var(--ink); }

    .wrap { max-width: 1080px; margin: 0 auto; padding: 0 1.25rem 4rem; }

    /* ---------- top bar ---------- */
    .bar {
        display: flex; align-items: center; justify-content: space-between;
        flex-wrap: wrap; gap: 1rem; padding: 1.5rem 0;
    }
    .brand {
        display: inline-block; text-decoration: none;
        font: 800 1.4rem/1 var(--display);
        background: var(--bone); border: var(--edge); border-radius: 6px;
        padding: .5rem .9rem; box-shadow: 4px 4px 0 var(--ink);
        transform: rotate(-2deg);
    }
    .nav { display: flex; flex-wrap: wrap; gap: .75rem; }

    /* ---------- buttons ---------- */
    .btn {
        display: inline-block; cursor: pointer; text-decoration: none;
        font: 700 1rem/1 var(--display); color: var(--ink);
        background: var(--sun); border: var(--edge); border-radius: 999px;
        padding: .8rem 1.3rem; box-shadow: 4px 4px 0 var(--ink);
        transition: transform .12s, box-shadow .12s;
    }
    .btn:hover { transform: translate(-2px, -2px); box-shadow: 6px 6px 0 var(--ink); }
    .btn:active { transform: translate(3px, 3px); box-shadow: 1px 1px 0 var(--ink); }
    .btn.ghost { background: var(--bone); }

    /* ---------- headline ---------- */
    h1 {
        margin: 1.5rem 0 2rem;
        font: 800 clamp(2.6rem, 7vw, 5rem)/.95 var(--display);
        letter-spacing: -.02em; color: var(--bone);
    }
    h1 .n {
        display: inline-block; margin-right: .15em; padding: 0 .25em;
        color: var(--ink); background: var(--sun);
        border: var(--edge); border-radius: 14px;
        box-shadow: 5px 5px 0 var(--ink); transform: rotate(-4deg);
    }

    /* ---------- toolbar ---------- */
    .tools {
        display: flex; flex-wrap: wrap; align-items: center;
        justify-content: space-between; gap: 1.2rem 1.5rem; margin-bottom: 2.2rem;
    }
    .chips { display: flex; flex-wrap: wrap; gap: .6rem; }
    .chip {
        display: inline-flex; align-items: center; gap: .5rem; text-decoration: none;
        font: 700 .95rem/1 var(--display);
        background: var(--bone); border: var(--edge); border-radius: 999px;
        padding: .6rem 1rem; box-shadow: 3px 3px 0 var(--ink);
        transition: transform .12s;
    }
    .chip:hover { transform: translate(-1px, -1px); }
    .chip[aria-current="true"] { background: var(--ink); color: var(--bone); }

    .dot { width: .75rem; height: .75rem; border-radius: 50%; border: 2px solid currentColor; }
    .dot.high { background: var(--hot); }
    .dot.medium { background: var(--sun); }
    .dot.low { background: var(--mint); }

    .find { display: flex; gap: .6rem; flex: 1 1 18rem; max-width: 26rem; }
    .find input {
        flex: 1; min-width: 0;
        font: 600 1rem var(--body); color: var(--ink);
        background: var(--bone); border: var(--edge); border-radius: 999px;
        padding: .7rem 1.1rem; box-shadow: 3px 3px 0 var(--ink);
    }

    /* ---------- task cards ---------- */
    .grid {
        list-style: none; margin: 0; padding: 0;
        display: grid; gap: 1.8rem;
        grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    }
    .grid li:nth-child(odd) { transform: rotate(-.6deg); }
    .grid li:nth-child(even) { transform: rotate(.5deg); }

    .card {
        display: flex; flex-direction: column; height: 100%; min-height: 210px;
        text-decoration: none; overflow: hidden;
        background: var(--bone); border: var(--edge); border-radius: 6px;
        box-shadow: 6px 6px 0 var(--ink);
        transition: transform .15s, box-shadow .15s;
        animation: stamp .45s cubic-bezier(.2, .9, .3, 1.2) backwards;
        animation-delay: calc(var(--i, 0) * 70ms);
    }
    .card:hover { transform: translate(-3px, -3px); box-shadow: 9px 9px 0 var(--ink); }
    .card:active { transform: translate(3px, 3px); box-shadow: 2px 2px 0 var(--ink); }
    .card .body { flex: 1; padding: 1.1rem 1rem .4rem; }
    .card .title { margin: 0; font: 800 1.5rem/1.15 var(--display); letter-spacing: -.01em; }
    .card .foot {
        display: flex; align-items: baseline; justify-content: space-between;
        padding: .8rem 1rem 1rem;
    }
    .card .id { font: 800 2.2rem/1 var(--display); }
    .card .open { font-weight: 600; text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 4px; }

    @keyframes stamp {
        from { opacity: 0; transform: translateY(-22px) scale(1.08) rotate(-3deg); }
    }

    /* ---------- priority colours ---------- */
    .tab {
        display: flex; align-items: center; justify-content: space-between; gap: 1rem;
        padding: .6rem 1rem; background: var(--sun);
        border-bottom: var(--edge); font: 800 .95rem/1 var(--display);
    }
    .p-high .tab { background: var(--hot); }
    .p-medium .tab { background: var(--sun); }
    .p-low .tab { background: var(--mint); }

    /* ---------- panels (details, form, messages) ---------- */
    .panel {
        max-width: 640px; margin-top: 1rem; overflow: hidden;
        background: var(--bone); border: var(--edge); border-radius: 6px;
        box-shadow: 9px 9px 0 var(--ink);
    }
    .panel .inner { padding: 1.6rem 1.6rem 1.9rem; }
    .headline {
        margin: 0 0 .5rem; color: var(--ink);
        font: 800 clamp(2rem, 5vw, 3rem)/1.05 var(--display); letter-spacing: -.02em;
    }
    .lead { margin: 0 0 .8rem; font-size: 1.25rem; font-weight: 600; }
    .meta {
        display: grid; grid-template-columns: auto 1fr; gap: .5rem 1.5rem;
        margin: 1.5rem 0 0; padding-top: 1.3rem; border-top: 3px dashed var(--ink);
    }
    .meta dt { font-weight: 600; opacity: .75; }
    .meta dd { margin: 0; font: 800 1.2rem var(--display); }
    .actions { display: flex; flex-wrap: wrap; gap: .9rem; margin-top: 1.8rem; }

    /* ---------- form ---------- */
    .field { margin-top: 1.3rem; }
    .field label, .legend { display: block; margin-bottom: .45rem; padding: 0; font: 700 1rem var(--display); }
    .field input[type="text"] {
        width: 100%; font: 600 1.05rem var(--body); color: var(--ink);
        background: #fff; border: var(--edge); border-radius: 6px; padding: .85rem 1rem;
    }
    .field input[type="text"]:focus-visible { outline-offset: 2px; box-shadow: 4px 4px 0 var(--ink); }
    fieldset { min-width: 0; margin: 1.3rem 0 0; padding: 0; border: 0; }
    .choices { position: relative; display: flex; flex-wrap: wrap; gap: .7rem; }
    .choices input { position: absolute; opacity: 0; pointer-events: none; }
    .choices label {
        display: inline-flex; align-items: center; gap: .5rem; cursor: pointer;
        font: 700 1rem var(--display); background: #fff;
        border: var(--edge); border-radius: 999px; padding: .7rem 1.1rem;
        box-shadow: 3px 3px 0 var(--ink); transition: transform .12s, box-shadow .12s;
    }
    .choices input:checked + label { transform: translate(2px, 2px); box-shadow: 1px 1px 0 var(--ink); }
    .choices input:checked + label::before { content: "\2713"; }
    .choices input:checked + label.high { background: var(--hot); }
    .choices input:checked + label.medium { background: var(--sun); }
    .choices input:checked + label.low { background: var(--mint); }
    .choices input:focus-visible + label { outline: 3px solid var(--ink); outline-offset: 3px; }

    @media (prefers-reduced-motion: reduce) {
        .card { animation: none; }
        .btn, .chip, .card, .choices label { transition: none; }
    }
</style>
